rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ronisouza495@gmail.com' && 
        request.auth.token.email_verified == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Game Validation
    function isValidGame(data) {
      return data.keys().hasAll(['name', 'category', 'imageUrl', 'description', 'officialLink']) &&
             data.keys().size() >= 5 &&
             data.keys().size() <= 8 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 500 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 2000 &&
             data.officialLink is string && data.officialLink.size() > 0 && data.officialLink.size() <= 500 &&
             (!data.keys().contains('ipaUrl') || (data.ipaUrl is string && data.ipaUrl.size() <= 1000)) &&
             (!data.keys().contains('manifestUrl') || (data.manifestUrl is string && data.manifestUrl.size() <= 1000));
    }

    // Log Validation
    function isValidLog(data) {
      return data.keys().hasAll(['gameId', 'action', 'timestamp', 'userEmail']) &&
             data.gameId is string &&
             data.action in ['added', 'updated', 'deleted'] &&
             data.userEmail == request.auth.token.email;
    }

    match /test/connection {
      allow read: if true;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if isAdmin() && isValidGame(incoming()) && isValidId(gameId);
      allow update: if isAdmin() && isValidGame(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'imageUrl', 'description', 'officialLink', 'ipaUrl', 'manifestUrl', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidLog(incoming()) && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
